server {
    listen 80;
    server_name municipalidadsm.online www.municipalidadsm.online;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name municipalidadsm.online www.municipalidadsm.online;

    ssl_certificate /etc/ssl/cloudflare/cloudflare-origin.pem;
    ssl_certificate_key /etc/ssl/cloudflare/cloudflare-origin.key;

    root /var/www/municipalidadsm.online;
    index index.html;

    client_max_body_size 20M;

    location /api/ {
        proxy_pass http://10.10.2.10:8080/api/;
        proxy_http_version 1.1;

        proxy_connect_timeout 60s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
        proxy_request_buffering off;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

server {
    listen 80;
    server_name auth.municipalidadsm.online;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name auth.municipalidadsm.online;

    ssl_certificate /etc/ssl/cloudflare/cloudflare-origin.pem;
    ssl_certificate_key /etc/ssl/cloudflare/cloudflare-origin.key;

    client_max_body_size 20M;

    location / {
        proxy_pass http://10.10.2.10:7000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
    }
}